;;; performance-tests.el --- Optimization checks -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'use-package)
(setq use-package-hook-name-suffix nil)
(let ((root (expand-file-name "../" (file-name-directory (or load-file-name buffer-file-name)))))
  (add-to-list 'load-path (expand-file-name "lisp/" root))
  (add-to-list 'load-path (expand-file-name "lisp/perinf/" root)))
(require 'emacs-nxs-mode-line)
(require 'perinf-core)
(defvar emacs-nxs-enable-highlight-keywords t)
(require 'emacs-nxs-highlight-keywords)
(ert-deftest project-cache-caches-file-errors ()
  (with-temp-buffer
    (let ((calls 0))
      (cl-letf (((symbol-function 'project-mode-line-format)
                 (lambda () (cl-incf calls) (signal 'file-error '("denied")))))
        (dotimes (_ 20) (should-not (emacs-nxs/project-display)))
        (should (= calls 1))
        (setq default-directory "/tmp/")
        (emacs-nxs/project-display)
        (should (= calls 2))))))
(ert-deftest project-cache-preserves-label-and-expires ()
  (with-temp-buffer
    (let ((calls 0))
      (cl-letf (((symbol-function 'project-mode-line-format)
                 (lambda () (cl-incf calls) " Project")))
        (should (equal (emacs-nxs/frame-title) "Emacs - [p] Project"))
        (should (equal (emacs-nxs/project-display) " Project"))
        (should (= calls 1))
        (setf (nth 1 emacs-nxs/project-display-cache) 0)
        (emacs-nxs/project-display)
        (should (= calls 2))))))
(ert-deftest project-cache-does-not-contact-remote ()
  (with-temp-buffer
    (setq default-directory "/ssh:dummy.invalid:/tmp/")
    (cl-letf (((symbol-function 'project-mode-line-format)
               (lambda () (ert-fail "Remote lookup attempted"))))
      (should-not (emacs-nxs/project-display)))))
(ert-deftest perinf-hidden-clock-does-no-storage-work ()
  (with-temp-buffer
    (cl-letf (((symbol-function 'perinf-core--clock-text)
               (lambda () (ert-fail "Hidden clock read storage"))))
      (perinf-core--update-clocks (current-buffer)))))
(ert-deftest perinf-visible-clock-updates ()
  (with-temp-buffer
    (insert "old\n")
    (setq-local perinf-core--clock-start (copy-marker (point-min))
                perinf-core--clock-end (copy-marker (point-max)))
    (cl-letf (((symbol-function 'get-buffer-window) (lambda (&rest _) t))
              ((symbol-function 'perinf-core--clock-text) (lambda () "new\n")))
      (perinf-core--update-clocks (current-buffer))
      (should (equal (buffer-string) "new\n"))
      (should (= (marker-position perinf-core--clock-end) (point-max))))))
(ert-deftest perinf-parser-skips-agenda-menu-preserves-todo ()
  (with-temp-buffer
    (insert "* TODO Test\n:PROPERTIES:\n:ID: example\n:END:\n")
    (cl-letf (((symbol-function 'org-install-agenda-files-menu)
               (lambda () (ert-fail "Internal parser rebuilt agenda menu"))))
      (perinf-storage--org-mode)
      (goto-char (point-min))
      (should (equal (org-get-todo-state) "TODO"))
      (should (equal (org-entry-get nil "ID") "example")))))
(ert-deftest highlighting-stays-in-programming-buffer ()
  (with-temp-buffer
    (setq buffer-file-name "/tmp/nxs-check-example.el")
    (emacs-lisp-mode)
    (should emacs-nxs/highlight-keywords-mode)
    (emacs-nxs/highlight-keywords-mode -1)
    (should-not emacs-nxs/highlight-keywords-mode))
  (with-temp-buffer
    (text-mode)
    (should-not emacs-nxs/highlight-keywords-mode)))

(require 'emacs-nxs-clipboard)
(ert-deftest clipboard-gui-uses-native-functions ()
  (skip-unless (eq system-type 'darwin))
  (let (copied)
    (cl-letf (((symbol-function 'display-graphic-p) (lambda (&rest _) t))
              ((symbol-function 'gui-select-text) (lambda (text) (setq copied text)))
              ((symbol-function 'gui-selection-value) (lambda () "æøå"))
              ((symbol-function 'start-process) (lambda (&rest _) (ert-fail "External clipboard process")))
              ((symbol-function 'call-process) (lambda (&rest _) (ert-fail "External clipboard process"))))
      (funcall interprogram-cut-function "æøå")
      (should (equal copied "æøå"))
      (should (equal (funcall interprogram-paste-function) "æøå")))))
(ert-deftest clipboard-terminal-retains-pbpaste ()
  (skip-unless (eq system-type 'darwin))
  (cl-letf (((symbol-function 'display-graphic-p) (lambda (&rest _) nil))
            ((symbol-function 'call-process)
             (lambda (program &rest _) (should (equal program "/usr/bin/pbpaste")) (insert "terminal") 0)))
    (should (equal (funcall interprogram-paste-function) "terminal"))))
(ert-deftest perinf-new-clock-uses-ten-seconds ()
  (with-temp-buffer
    (let (interval)
      (cl-letf (((symbol-function 'perinf-core--clock-text) (lambda () ""))
                ((symbol-function 'run-with-timer)
                 (lambda (delay repeat &rest _) (setq interval (list delay repeat)) :fake)))
        (perinf-core--insert-clocks)
        (should (equal interval '(10 10)))))))
(ert-run-tests-batch-and-exit)
